// Schéma MyHousehold — source de vérité : docs/data-model.md
//
// Conventions appliquées partout :
//   - clés primaires UUID v7 (triables par date), générables côté client
//   - tous les instants en timestamptz (UTC)
//   - createdAt / updatedAt / deletedAt sur chaque table synchronisée :
//     la suppression est logique, sinon un client hors-ligne ne peut pas
//     apprendre qu'un objet a disparu
//   - un serveur sert UN SEUL foyer : household n'a qu'une ligne vivante,
//     et householdId reste sur les tables métier comme simple rattachement

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Énumérations ─────────────────────────────

/// Droits portés par un statut. Les routes exigent un droit, jamais un
/// nom de statut : un foyer qui renomme « Adulte » en « Grand » ne doit
/// pas changer de comportement.
enum Right {
  VIEW
  COMPLETE_TASKS
  MANAGE_TASKS
  MANAGE_APPOINTMENTS
  MANAGE_MEMBERS
  MANAGE_STATUSES
  MANAGE_SERVER
}

/// Les trois façons d'être due. Ce qui change d'une tâche à l'autre,
/// c'est *quand* elle est due — et c'est le seul axe qui compte pour
/// l'organisation d'un foyer.
enum TaskKind {
  /// À une date, selon une récurrence.
  SCHEDULED
  /// À refaire dans un délai, pas à une date. Ce que la version
  /// précédente appelait un « compteur » : ce n'était pas une autre
  /// nature d'objet, et deux listes là où le foyer n'en vit qu'une
  /// était une erreur.
  BACKGROUND
  /// Une seule fois, avec ou sans date limite.
  ONE_OFF
}

enum AssignmentMode {
  FIXED
  ROTATION
  ANYONE
}

enum OccurrenceStatus {
  PENDING
  DONE
  SKIPPED
  MISSED
}

enum AppointmentVisibility {
  HOUSEHOLD
  PRIVATE
}

enum AppointmentSource {
  LOCAL
  IMPORTED
}

enum AttendeeResponse {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum CalendarProvider {
  GOOGLE
  CALDAV
  ICS_URL
}

enum SyncDirection {
  PULL
  PUSH
  BOTH
}

enum PushProvider {
  FCM
  UNIFIEDPUSH
  NONE
}

enum ReminderTargetType {
  APPOINTMENT
  TASK_OCCURRENCE
}

enum SetupPairingPurpose {
  /// L'app pousse la configuration qu'elle a déjà.
  IMPORT
  /// L'app crée le premier compte, qui devient administrateur.
  CLAIM
}

enum ActivityVerb {
  TASK_COMPLETED
  TASK_SKIPPED
  TASK_MISSED
  BACKGROUND_TASK_DONE
  APPOINTMENT_CREATED
  MEMBER_JOINED
  MEMBER_ACCOUNT_DELETED
  MEMBER_STATUS_CHANGED
  ADMIN_RIGHTS_TRANSFERRED
}

// ──────────────────────── Identité et foyer ─────────────────────────────

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Ce qu'on tape pour se connecter — pas d'adresse e-mail : un
  /// serveur de maison n'envoie pas de courrier. En minuscules.
  /// Après suppression du compte : remplacé par une valeur inutilisable.
  username     String    @unique
  firstName    String
  lastName     String
  /// Facultative : on ne force personne à déclarer sa date de naissance.
  birthDate    DateTime? @db.Date
  passwordHash String
  /// Son statut, donc ses droits. Ce qui remplace l'ancien rôle de foyer
  /// et l'ancien drapeau « administrateur de l'instance ».
  statusId     String    @db.Uuid
  /// Photo de profil : un fichier, à côté de la base. Les images n'ont
  /// rien à faire dans une base que l'on sauvegarde par pg_dump.
  avatarPath   String?
  avatarColor  String    @default("#6750A4")
  locale       String    @default("fr-FR")
  /// Fuseau personnel. Null = celui du foyer, qui reste la référence
  /// pour calculer les échéances.
  timezone     String?

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  /// Compte supprimé : la ligne est conservée anonymisée pour que
  /// l'historique du foyer reste cohérent (« Ancien membre a sorti les
  /// poubelles »). Identifiant, nom et empreinte sont écrasés à la suppression.
  deletedAt DateTime? @db.Timestamptz

  status               Status                  @relation(fields: [statusId], references: [id])
  devices              Device[]
  refreshTokens        RefreshToken[]
  calendarAccounts     CalendarAccount[]
  notificationPref     NotificationPreference?
  assignedTasks        TaskAssignee[]
  assignedOccurrences  TaskOccurrence[]        @relation("occurrenceAssignee")
  completedOccurrences TaskOccurrence[]        @relation("occurrenceCompletedBy")
  attendances          AppointmentAttendee[]
  reminders            Reminder[]
  activities           ActivityLog[]
  createdInvites       Invite[]

  @@index([statusId])
  @@map("user")
}

/// Un statut, ce sont des droits. **Il ne se configure que depuis
/// l'interface web du serveur** : un réglage qui engage la sécurité du
/// foyer se fait assis, sur un vrai écran. Ce n'est pas une contrainte
/// technique — le serveur ne sait pas qui l'appelle — mais une décision
/// de produit, tenue côté client.
model Status {
  id        String  @id @default(uuid(7)) @db.Uuid
  name      String
  rights    Right[]
  /// Statut donné aux nouveaux membres.
  isDefault Boolean @default(false)
  position  Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  users   User[]
  invites Invite[]

  @@map("status")
}

model Household {
  id           String @id @default(uuid(7)) @db.Uuid
  name         String
  /// Identifiant IANA. Référence pour dérouler les récurrences :
  /// « chaque lundi 19h » doit rester 19h locales après un changement d'heure.
  timezone     String @default("Europe/Paris")
  weekStartsOn Int    @default(1) @db.SmallInt

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  invites      Invite[]
  tasks        Task[]
  taskGroups   TaskGroup[]
  occurrences  TaskOccurrence[]
  appointments Appointment[]
  activities   ActivityLog[]

  @@map("household")
}

model Invite {
  id          String   @id @default(uuid(7)) @db.Uuid
  householdId String   @db.Uuid
  /// 8 caractères, alphabet sans ambiguïté visuelle (ni 0/O ni 1/l).
  code        String   @unique
  /// Statut attribué à l'arrivée.
  statusId    String   @db.Uuid
  maxUses     Int      @default(1)
  useCount    Int      @default(0)
  expiresAt   DateTime @db.Timestamptz
  createdById String   @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  status    Status    @relation(fields: [statusId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([householdId])
  @@map("invite")
}

// ──────────────────────── Tâches récurrentes ────────────────────────────

/// Un groupe rassemble des tâches qui vont ensemble. Une tâche
/// appartient à **un groupe au plus** : les appartenances multiples
/// transforment une liste de corvées en système de classement, et
/// personne ne range ses corvées.
model TaskGroup {
  id          String @id @default(uuid(7)) @db.Uuid
  householdId String @db.Uuid
  name        String
  /// Repère de lecture en liste.
  color       String @default("#0F766E")
  position    Int    @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([householdId])
  @@map("task_group")
}

/// **Tout est une tâche.** Récurrente, de fond ou ponctuelle : seule
/// change la façon dont elle est due.
model Task {
  id          String   @id @default(uuid(7)) @db.Uuid
  householdId String   @db.Uuid
  title       String
  description String?
  kind        TaskKind @default(SCHEDULED)
  groupId     String?  @db.Uuid
  /// De +3 (urgente) à −3 (en dernier), 0 = normale. Entier signé : le
  /// tri est évident, et un niveau s'ajoute sans migration de données.
  priority    Int      @default(0)

  /// SCHEDULED — RRULE RFC 5545, sans le préfixe « RRULE: ».
  rrule      String?
  /// SCHEDULED — heure locale d'échéance. Null = toute la journée.
  dueTime    String? @db.VarChar(5)
  /// SCHEDULED — délai après l'échéance avant de marquer MISSED.
  graceHours Int     @default(24)

  /// BACKGROUND — délai maximum entre deux fois. Null = la tâche ne fait
  /// que compter le temps écoulé, sans jamais être en retard.
  maxIntervalSeconds Int?
  /// BACKGROUND — fraction du délai à partir de laquelle on prévient.
  warnRatio          Decimal @default(0.8) @db.Decimal(3, 2)

  /// ONE_OFF — date limite, facultative.
  dueDate DateTime? @db.Date

  assignmentMode AssignmentMode @default(ANYONE)
  isActive       Boolean        @default(true)
  startsOn       DateTime?      @db.Date
  endsOn         DateTime?      @db.Date
  createdById    String         @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  group       TaskGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  assignees   TaskAssignee[]
  occurrences TaskOccurrence[]

  @@index([householdId, isActive])
  @@index([householdId, kind, isActive])
  @@index([householdId, updatedAt])
  @@index([groupId])
  @@map("task")
}

model TaskAssignee {
  taskId   String @db.Uuid
  userId   String @db.Uuid
  /// Ordre du tour de rôle.
  position Int    @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignee")
}

/// Occurrences matérialisées en base, et non déroulées à la lecture :
/// une occurrence s'assigne, s'annote, se reporte, et un client
/// hors-ligne doit pouvoir la porter.
model TaskOccurrence {
  id           String    @id @default(uuid(7)) @db.Uuid
  taskId       String    @db.Uuid
  /// Dupliqué depuis la définition pour filtrer sans jointure.
  householdId  String    @db.Uuid
  /// Jour d'échéance en heure locale du foyer. Date pure : la convertir
  /// en instant la décalerait d'un jour selon le fuseau. Absent pour une
  /// tâche de fond, qui n'a pas de date mais un délai.
  scheduledFor DateTime? @db.Date
  /// Instant calculé depuis scheduledFor + dueTime dans le fuseau du foyer.
  dueAt        DateTime? @db.Timestamptz
  assigneeId   String?   @db.Uuid

  status        OccurrenceStatus @default(PENDING)
  completedAt   DateTime?        @db.Timestamptz
  /// Peut différer de l'assigné : quelqu'un a dépanné.
  completedById String?          @db.Uuid
  note          String?

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("occurrenceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy User?     @relation("occurrenceCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  /// Rend le job de matérialisation idempotent et rejouable sans danger.
  /// Une tâche de fond, dont `scheduledFor` est nul, n'est pas
  /// concernée : PostgreSQL ne considère jamais deux NULL comme égaux,
  /// et deux complétions sont bien deux faits distincts.
  @@unique([taskId, scheduledFor])
  @@index([householdId, scheduledFor, status])
  @@index([assigneeId, status])
  @@index([householdId, updatedAt])
  @@map("task_occurrence")
}

// ──────────────────────────── Rendez-vous ───────────────────────────────

model Appointment {
  id          String  @id @default(uuid(7)) @db.Uuid
  householdId String  @db.Uuid
  title       String
  description String?
  location    String?

  startAt      DateTime @db.Timestamptz
  endAt        DateTime @db.Timestamptz
  /// Si vrai, startAt est minuit dans le fuseau du foyer.
  isAllDay     Boolean  @default(false)
  rrule        String?
  /// Instance modifiée d'une récurrence importée (RECURRENCE-ID iCalendar).
  recurrenceId String?

  visibility        AppointmentVisibility @default(HOUSEHOLD)
  source            AppointmentSource     @default(LOCAL)
  /// Renseignés si source = IMPORTED. Un événement importé est en lecture
  /// seule en v1 : toute modification renvoie APPOINTMENT_READ_ONLY.
  calendarAccountId String?               @db.Uuid
  externalUid       String?
  createdById       String                @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  household     Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  attendees     AppointmentAttendee[]
  externalEvent ExternalEvent?

  @@index([householdId, startAt, endAt])
  @@index([householdId, updatedAt])
  @@map("appointment")
}

model AppointmentAttendee {
  appointmentId String           @db.Uuid
  userId        String           @db.Uuid
  response      AttendeeResponse @default(NEEDS_ACTION)
  respondedAt   DateTime?        @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([appointmentId, userId])
  @@index([userId])
  @@map("appointment_attendee")
}

model Reminder {
  id            String             @id @default(uuid(7)) @db.Uuid
  targetType    ReminderTargetType
  targetId      String             @db.Uuid
  /// Négatif = avant l'échéance.
  offsetMinutes Int
  /// Null = tous les membres concernés.
  userId        String?            @db.Uuid
  /// Garde-fou anti-doublon : un rappel envoyé ne se renvoie pas.
  sentAt        DateTime?          @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([sentAt])
  @@map("reminder")
}

// ────────────────────── Synchronisation d'agenda ────────────────────────

model CalendarAccount {
  /// Un agenda appartient à une personne, jamais au foyer : elle en garde
  /// le contrôle et peut le retirer à tout moment.
  id          String           @id @default(uuid(7)) @db.Uuid
  userId      String           @db.Uuid
  provider    CalendarProvider
  displayName String
  /// Chiffré en AES-256-GCM, clé hors base (MH_ENCRYPTION_KEY). Aucune
  /// route ne relit ce champ, pas même pour son propriétaire.
  credentials Bytes

  syncDirection     SyncDirection         @default(PULL)
  defaultVisibility AppointmentVisibility @default(HOUSEHOLD)
  /// N'importe que la plage horaire, sans le titre. Activé par défaut :
  /// partager ses disponibilités ne doit pas exposer son agenda pro.
  busyOnly          Boolean               @default(true)

  /// syncToken Google, ctag CalDAV ou ETag HTTP selon le fournisseur.
  syncCursor  String?
  lastSyncAt  DateTime? @db.Timestamptz
  lastErrorAt DateTime? @db.Timestamptz
  lastError   String?
  isActive    Boolean   @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalEvents ExternalEvent[]

  @@index([userId])
  @@index([isActive, lastSyncAt])
  @@map("calendar_account")
}

model ExternalEvent {
  calendarAccountId String   @db.Uuid
  /// UID iCalendar de l'événement distant.
  externalUid       String
  appointmentId     String   @unique @db.Uuid
  etag              String?
  /// Un événement non revu après une synchronisation *complète* est
  /// supprimé. Jamais après un delta : il n'en contient qu'une partie.
  lastSeenAt        DateTime @db.Timestamptz

  account     CalendarAccount @relation(fields: [calendarAccountId], references: [id], onDelete: Cascade)
  appointment Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@id([calendarAccountId, externalUid])
  @@map("external_event")
}

// ──────────────────────────── Technique ─────────────────────────────────

model Device {
  id           String       @id @default(uuid(7)) @db.Uuid
  userId       String       @db.Uuid
  pushToken    String?
  pushProvider PushProvider @default(NONE)
  platform     String?
  appVersion   String?
  lastSeenAt   DateTime     @default(now()) @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("device")
}

model RefreshToken {
  id        String  @id @default(uuid(7)) @db.Uuid
  userId    String  @db.Uuid
  deviceId  String? @db.Uuid
  /// SHA-256 : le jeton en clair n'est jamais stocké.
  tokenHash String  @unique

  expiresAt    DateTime  @db.Timestamptz
  revokedAt    DateTime? @db.Timestamptz
  /// Chaîne de rotation. Si un jeton déjà remplacé est présenté, c'est un
  /// rejeu : toute la chaîne est révoquée.
  replacedById String?   @unique @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  replaces   RefreshToken? @relation("tokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedBy RefreshToken? @relation("tokenRotation")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token")
}

model NotificationPreference {
  userId String @id @db.Uuid

  tasksEnabled        Boolean @default(true)
  appointmentsEnabled Boolean @default(true)
  householdActivity   Boolean @default(false)

  /// Heures de silence, en heure locale de l'utilisateur. Format HH:mm.
  quietHoursStart        String? @db.VarChar(5)
  quietHoursEnd          String? @db.VarChar(5)
  /// Rappel par défaut appliqué aux nouveaux rendez-vous, en minutes avant.
  defaultReminderMinutes Int     @default(30)

  updatedAt DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

/// Fil d'activité du foyer. Dénormalisé exprès : il doit rester lisible
/// après suppression de l'objet concerné.
model ActivityLog {
  id          String       @id @default(uuid(7)) @db.Uuid
  householdId String       @db.Uuid
  actorId     String?      @db.Uuid
  verb        ActivityVerb
  subjectType String?
  subjectId   String?      @db.Uuid
  /// Texte figé au moment de l'événement.
  summary     String

  createdAt DateTime @default(now()) @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt(sort: Desc)])
  @@map("activity_log")
}

/// Dernière vérification des versions publiées. Une seule ligne.
///
/// Le serveur regarde s'il existe une version plus récente de lui-même
/// et de l'application. Ce n'est pas de la télémétrie : rien n'est
/// envoyé, on lit une page de publications. La vérification se coupe
/// (`MH_UPDATE_CHECK=false`) pour qui ne veut aucun appel sortant.
model ReleaseCheck {
  id Int @id @default(1)

  /// Dernière version publiée du serveur, et sa date.
  serverVersion     String?
  serverPublishedAt DateTime? @db.Timestamptz
  serverNotesUrl    String?

  /// Dernière version publiée de l'app, et de quoi l'installer. Le
  /// serveur les relaie au foyer : cinq téléphones téléchargent le même
  /// APK, autant qu'il vienne du placard.
  appVersion     String?
  appPublishedAt DateTime? @db.Timestamptz
  appDownloadUrl String?
  appSha256      String?

  checkedAt DateTime? @db.Timestamptz
  lastError String?

  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("release_check")
}

/// État de l'assistant d'installation. Une seule ligne, `id = 1`.
///
/// Cet état vit côté serveur et non en session : on change d'appareil en
/// cours de route — l'étape réseau se fait depuis un téléphone connecté
/// au point d'accès du Pi, la suite depuis un ordinateur de la maison —
/// et une coupure de courant doit reprendre où l'on en était.
model ServerSetup {
  id Int @id @default(1)

  /// Imprimé dans les journaux au premier démarrage. Exigé seulement
  /// quand un reverse proxy masque l'adresse d'origine, car la
  /// protection « réseau privé » ne peut alors plus s'appliquer.
  setupToken  String
  firstBootAt DateTime @default(now()) @db.Timestamptz

  networkDone Boolean @default(false)
  importDone  Boolean @default(false)

  /// Configuration poussée par l'app à l'étape 2. Elle est stockée et
  /// non appliquée tout de suite : les tâches et compteurs ont besoin
  /// d'un auteur, et aucun compte n'existe encore à cette étape. Tout
  /// est créé au moment où le compte administrateur l'est.
  pendingImport Json?

  householdId String?   @db.Uuid
  adminUserId String?   @db.Uuid
  completedAt DateTime? @db.Timestamptz

  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("server_setup")
}

/// Code d'appariement entre la page d'installation et le téléphone.
model SetupPairing {
  code      String              @id
  purpose   SetupPairingPurpose
  expiresAt DateTime            @db.Timestamptz
  usedAt    DateTime?           @db.Timestamptz
  createdAt DateTime            @default(now()) @db.Timestamptz

  @@index([expiresAt])
  @@map("setup_pairing")
}

/// Déduplication des mutations poussées par le mobile. Conservée 30 jours :
/// c'est elle qui garantit l'idempotence même si la réponse se perd.
model ProcessedMutation {
  clientMutationId String   @id @db.Uuid
  userId           String   @db.Uuid
  type             String
  /// Réponse renvoyée la première fois, rejouée telle quelle en cas de
  /// nouvelle présentation.
  result           Json
  processedAt      DateTime @default(now()) @db.Timestamptz

  @@index([processedAt])
  @@map("processed_mutation")
}
