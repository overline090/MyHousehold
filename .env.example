# ─────────────────────────────────────────────────────────────
# MyHousehold — exemple de configuration
# Copier en .env et remplacer toutes les valeurs « CHANGEME ».
# Générer chaque secret avec :  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# Base de données et file de jobs.
# Avec docker-compose, POSTGRES_PASSWORD suffit : DATABASE_URL et
# REDIS_URL sont composés automatiquement pour le conteneur.
POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql://myhousehold:CHANGEME@db:5432/myhousehold
REDIS_URL=redis://redis:6379

# Signature des jetons d'authentification
MH_JWT_SECRET=CHANGEME

# Chiffrement des identifiants d'agenda.
# ATTENTION : perdre cette clé rend les agendas déjà connectés
# indéchiffrables. À sauvegarder SÉPARÉMENT du dump de base.
MH_ENCRYPTION_KEY=CHANGEME

# URL publique du serveur (utilisée pour le callback OAuth)
MH_PUBLIC_URL=https://household.example.com

# Passer à false dès que les comptes du foyer sont créés
MH_ALLOW_REGISTRATION=true

MH_DEFAULT_TIMEZONE=Europe/Paris

# Base jetable, utilisée seulement pour CRÉER une migration en
# développement (prisma migrate dev). Inutile en production.
# SHADOW_DATABASE_URL=postgresql://myhousehold:CHANGEME@db:5432/myhousehold_shadow

# Synchro Google Calendar (optionnel) — voir docs/self-hosting.md
# MH_GOOGLE_CLIENT_ID=
# MH_GOOGLE_CLIENT_SECRET=

# Notifications push (optionnel)
# MH_FCM_SERVICE_ACCOUNT=/run/secrets/fcm.json

# Documentation OpenAPI sur /api/docs
MH_EXPOSE_DOCS=false
